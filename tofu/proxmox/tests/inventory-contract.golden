[jump_host]
nkp-jump-host ansible_host=10.10.10.80

[control_plane]
nkp-cp-01 ansible_host=10.10.10.81

[workers]
nkp-worker-01 ansible_host=10.10.10.86

[nkp_nodes:children]
control_plane
workers

[all:vars]
# Generated by tofu/proxmox for os_distribution=ubuntu24,
# sizing_profile=contract-test. Before ./deploy.sh install, add the NKP
# CLI path and checksums from inventory.example.ini, and replace the MetalLB
# pool below with addresses of your own.
ansible_user = nutanix
# ubuntu or ubuntu-cis (CIS baseline on top of the same image)
os_profile = ubuntu
cluster_name = nkp-cluster
control_plane_vip = 10.10.10.85
# The Proxmox cloud-init network config names the first NIC eth0 on both images
virtual_ip_interface = eth0
# MetalLB Layer 2 address pool (NKP dashboard and LoadBalancer services): unused
# addresses in the node subnet, with no host or VIP address inside the range.
# EXAMPLE VALUE, the module does not know which addresses are free: replace it.
metallb_ip_range = 10.10.10.90-10.10.10.99
# Worker disks created by this module, named by their serial number through
# the stable /dev/disk/by-id links (kernel names such as sdb do not follow the
# SCSI slot and can change at reboot): nkp-ceph = raw Ceph OSD
# (5 GB), nkp-vol1..nkp-vol4 = local volumes 1..4
# (5 GB each)
ceph_osd_device = /dev/disk/by-id/scsi-SQEMU_QEMU_HARDDISK_nkp-ceph
local_volume_devices = ["/dev/disk/by-id/scsi-SQEMU_QEMU_HARDDISK_nkp-vol1","/dev/disk/by-id/scsi-SQEMU_QEMU_HARDDISK_nkp-vol2","/dev/disk/by-id/scsi-SQEMU_QEMU_HARDDISK_nkp-vol3","/dev/disk/by-id/scsi-SQEMU_QEMU_HARDDISK_nkp-vol4"]
# Read by ./deploy.sh tofu-* only (Ansible ignores it): the profile these VMs
# were created with, so that later plan, apply and destroy runs keep using it.
tofu_sizing_profile = contract-test
# contract-test VMs are below the NKP minimums: run only ./deploy.sh tofu-verify
# on them (it skips the size thresholds), never ./deploy.sh install.
