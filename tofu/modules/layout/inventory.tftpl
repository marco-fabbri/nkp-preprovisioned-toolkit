[jump_host]
${jump_host_name} ansible_host=${jump_host_ip}

[control_plane]
%{for idx, ip in control_plane_ips~}
${control_plane_names[idx]} ansible_host=${ip}
%{endfor~}

[workers]
%{for idx, ip in worker_ips~}
${worker_names[idx]} ansible_host=${ip}
%{endfor~}

[nkp_nodes:children]
control_plane
workers

[all:vars]
# Generated by tofu/${provider_name} for os_distribution=${os_distribution},
# sizing_profile=${sizing_profile}. Before ./deploy.sh install, add the NKP
# CLI path and checksums from inventory.example.ini, and replace the MetalLB
# pool below with addresses of your own.
ansible_user = ${vm_user}
# ${os_family} or ${os_family}-cis (CIS baseline on top of the same image)
os_profile = ${os_family}
cluster_name = nkp-cluster
control_plane_vip = ${control_plane_vip}
# ${nic_comment}
virtual_ip_interface = ${nic_name}
# MetalLB Layer 2 address pool (NKP dashboard and LoadBalancer services): unused
# addresses in the node subnet, with no host or VIP address inside the range.
# EXAMPLE VALUE, the module does not know which addresses are free: replace it.
metallb_ip_range = 10.10.10.90-10.10.10.99
${disk_comment}
ceph_osd_device = ${ceph_osd_device}
local_volume_devices = ${jsonencode(local_volume_devices)}
# Read by ./deploy.sh tofu-* only (Ansible ignores it): the profile these VMs
# were created with, so that later plan, apply and destroy runs keep using it.
tofu_sizing_profile = ${sizing_profile}
%{if sizing_profile == "contract-test"~}
# contract-test VMs are below the NKP minimums: run only ./deploy.sh tofu-verify
# on them (it skips the size thresholds), never ./deploy.sh install.
%{endif~}
